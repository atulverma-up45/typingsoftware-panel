# ==============================================================================
# Typing Software Admin Panel - Environment Variables
# ==============================================================================

# Backend REST API Base URL
# Base endpoint used by Axios for domain modules (users, activations, licenses, content, etc.)
VITE_API_BASE_URL="http://localhost:8787/api"

# Better Auth Base URL
# Origin of the backend server hosting Better Auth endpoints (/api/auth/*).
# Used by Better Auth React client for sign-in, sign-out, session checks, etc.
VITE_AUTH_URL="http://localhost:8787"

